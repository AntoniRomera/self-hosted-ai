# Self-Hosted AI Stack - environment configuration
#
# Copy this file to `.env` and fill in the values:
#
#   cp .env.example .env
#
# `.env` is gitignored. NEVER commit real secrets (TS_AUTHKEY, WEBUI_SECRET_KEY).

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Comma-separated list of Ollama models that scripts/preload-models.sh pulls.
# Defaults are small and run on modest CPU-only hardware. nomic-embed-text
# enables Open WebUI's RAG / embeddings features.
OLLAMA_MODELS="llama3.2:3b,qwen2.5:3b,nomic-embed-text"

# How long a model stays loaded in memory after its last request.
# Examples: 5m, 30m, 1h, -1 (keep forever), 0 (unload immediately).
OLLAMA_KEEP_ALIVE="5m"

# ---------------------------------------------------------------------------
# Open WebUI
# ---------------------------------------------------------------------------
# Host port used ONLY when you enable the local-only override
# (docker-compose.override.yml). Ignored otherwise.
WEBUI_PORT="3000"

# Required. Signs session cookies. Generate a strong random value, e.g.:
#   openssl rand -hex 32
WEBUI_SECRET_KEY="change-me-generate-with-openssl-rand-hex-32"

# Set to "false" to disable the login screen (single trusted user on a private
# tailnet only). Keep "true" for anything internet-reachable.
WEBUI_AUTH="true"

# ---------------------------------------------------------------------------
# Tailscale
# ---------------------------------------------------------------------------
# Required. Auth key from https://login.tailscale.com/admin/settings/keys
# Prefer a reusable + ephemeral + tagged key for unattended hosts.
TS_AUTHKEY="tskey-auth-REPLACE-ME"

# Node name on your tailnet (MagicDNS). Open WebUI will be reachable at
# https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME="self-hosted-ai"

# Extra args passed to `tailscale up` (optional), e.g. "--advertise-tags=tag:ai"
TS_EXTRA_ARGS=""

# ---------------------------------------------------------------------------
# Compose profiles / optional Caddy reverse proxy (public TLS)
# ---------------------------------------------------------------------------
# Leave empty for tailnet-only access (recommended). Set to "tls" to also start
# the Caddy reverse proxy for public internet exposure with automatic HTTPS.
COMPOSE_PROFILES=""

# Public domain Caddy issues a certificate for. Required only when the "tls"
# profile is enabled. Its A/AAAA record must point at this host.
CADDY_DOMAIN="ai.example.com"

# ---------------------------------------------------------------------------
# Image pins (override to upgrade / track a different tag)
# ---------------------------------------------------------------------------
OLLAMA_IMAGE="ollama/ollama:0.5.7"
OPENWEBUI_IMAGE="ghcr.io/open-webui/open-webui:v0.5.20"
TAILSCALE_IMAGE="tailscale/tailscale:v1.80.0"
CADDY_IMAGE="caddy:2.8-alpine"
